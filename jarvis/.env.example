# Copy to .env and fill in. NEVER commit .env.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Models: cheap watcher/triage vs the main brain
JARVIS_BRAIN_MODEL=claude-opus-4-8
JARVIS_TRIAGE_MODEL=claude-haiku-4-5

# Owner + persona
JARVIS_OWNER_NAME=sir
JARVIS_LANGUAGE=en

# TTS backend: say | piper | chatterbox
# - say:        macOS built-in `say`, zero setup, works on the Mac today
# - piper:      CPU-only local Piper (set JARVIS_PIPER_* below)
# - chatterbox: local Chatterbox-TTS-Server (set JARVIS_CHATTERBOX_URL)
JARVIS_TTS_BACKEND=say
JARVIS_SAY_VOICE=Daniel

# Piper (only if JARVIS_TTS_BACKEND=piper)
JARVIS_PIPER_BIN=piper
JARVIS_PIPER_MODEL=/path/to/en_GB-alan-medium.onnx

# Chatterbox (only if JARVIS_TTS_BACKEND=chatterbox) — OpenAI-compatible endpoint
JARVIS_CHATTERBOX_URL=http://127.0.0.1:8004/v1/audio/speech
JARVIS_CHATTERBOX_VOICE=jarvis

# Where rendered audio clips are written
JARVIS_AUDIO_DIR=./audio_out
